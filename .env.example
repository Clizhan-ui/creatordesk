# CreatorDesk Environment Configuration Example
# Copy this file to .env and set your own secure secrets

# JWT Secret for Session Authentication (minimum 32 characters in production)
JWT_SECRET=supersecret-creatordesk-jwt-token-key-change-in-production-1234567890

# Database Configuration (Defaults to embedded SQLite)
DATABASE_PATH=creatordesk.db

# Optional Supabase integration for cloud deployment
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
